@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-2">
        <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 30px; height: 30px; background: rgba(23,163,74,0.2);">
            <i class="bi bi-person-fill" style="color: #1DB954; font-size: 0.9rem;"></i>
        </div>
        <span class="text-white-50 small fw-medium">@UserManager.GetUserName(User)</span>
        <form method="post" asp-area="Identity" asp-controller="Account" asp-action="Logout" class="ms-1">
            <button type="submit" class="btn btn-sm btn-outline-light" style="font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase;">
                Logout
            </button>
        </form>
    </div>
}
else
{
    <a class="text-white-50 text-decoration-none small fw-medium nav-link-hover" asp-area="Identity" asp-controller="Account" asp-action="Register">Register</a>
    <a class="btn btn-sm btn-accent fw-semibold" asp-area="Identity" asp-controller="Account" asp-action="Login">Login</a>
}