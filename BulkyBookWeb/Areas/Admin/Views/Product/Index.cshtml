<div class="container-fluid py-4">
    <div class="card panel-card border shadow-sm overflow-hidden">
        <div class="panel-header py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="panel-header-icon"><i class="bi bi-grid"></i></div>
                <div>
                    <h5 class="mb-0 fw-bold">Products</h5>
                    <p class="mb-0 small" style="color: #1DB954;">Manage your product catalog</p>
                </div>
            </div>
            <a asp-controller="Product" asp-action="Upsert" class="btn btn-sm btn-accent fw-semibold d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> New Product
            </a>
        </div>
        <div class="table-responsive">
            <table id="tblData" class="table-styled">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>ISBN</th>
                        <th>Price</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/product.js" asp-append-version="true"></script>
}