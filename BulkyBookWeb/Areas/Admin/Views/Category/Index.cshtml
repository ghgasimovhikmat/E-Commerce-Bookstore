@using BulkyBook.Models
@model List<Category>

<div class="container-fluid py-4">
    <div class="card panel-card border shadow-sm overflow-hidden">
        <div class="panel-header py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="panel-header-icon"><i class="bi bi-grid"></i></div>
                <div>
                    <h5 class="mb-0 fw-bold">Categories</h5>
                    <p class="mb-0 small" style="color: #1DB954;">Manage your product categories</p>
                </div>
            </div>
            <a asp-controller="Category" asp-action="Create" class="btn btn-sm btn-accent fw-semibold d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> New Category
            </a>
        </div>

        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="table-styled">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Display Order</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obj in Model)
                        {
                            <tr>
                                <td class="fw-medium" style="color: #1e293b;">@obj.Name</td>
                                <td><span class="badge bg-light text-dark border">@obj.DisplayOrder</span></td>
                                <td class="text-end">
                                    <a asp-action="Update" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-success me-1"><i class="bi bi-pencil-square me-1"></i>Edit</a>
                                    <a asp-action="Delete" asp-route-id="@obj.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox d-block"></i>
                    <p class="mb-0">No categories yet. Create your first one to get started.</p>
                </div>
            }
        </div>
    </div>
</div>