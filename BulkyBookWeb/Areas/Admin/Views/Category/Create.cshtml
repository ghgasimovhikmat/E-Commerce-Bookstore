@using BulkyBook.Models
@model Category

<div class="container-fluid py-3">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to categories
    </a>
    <div class="card panel-card border shadow-sm overflow-hidden">
        <div class="panel-header py-3 px-4 d-flex align-items-center gap-3">
            <div class="panel-header-icon"><i class="bi bi-plus-lg"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Create Category</h5>
                <p class="mb-0 small" style="color: #1DB954;">Add a new category for your products</p>
            </div>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter category name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-semibold small"></label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" placeholder="Enter display order" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent fw-semibold">Create Category</button>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}