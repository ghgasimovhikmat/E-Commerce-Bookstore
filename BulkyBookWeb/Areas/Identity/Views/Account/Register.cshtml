@model RegisterVM

<div class="container py-5">
    <div class="auth-shell mx-auto" style="max-width: 1140px;">
        <div class="row g-0">
            <div class="col-lg-4 d-none d-lg-flex">
                <div class="auth-brand-panel">
                    <div class="auth-brand-logo">
                        <i class="bi bi-book fs-4" style="color: #1DB954;"></i>
                        <span class="fw-bold fs-5">Bulky<span style="color:#1DB954;">Book</span></span>
                    </div>

                    <div class="auth-brand-body">
                        <h2>Join a growing shelf of readers.</h2>
                        <p>Create your account to start browsing, saving favorites, and checking out faster next time.</p>
                    </div>

                    <ul class="auth-brand-features">
                        <li><i class="bi bi-check-circle-fill"></i> Free account, no commitment</li>
                        <li><i class="bi bi-check-circle-fill"></i> Faster checkout on every order</li>
                        <li><i class="bi bi-check-circle-fill"></i> Personalized recommendations</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="auth-form-panel">
                    <p class="auth-eyebrow">Get started</p>
                    <h3>Create your account</h3>

                    <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">

                        <div asp-validation-summary="ModelOnly" class="text-bg-danger rounded-3 p-2 mb-3 small"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name"></label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="John Doe" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email"></label>
                                <div class="auth-input-group">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password"></label>
                                <div class="auth-input-group">
                                    <i class="bi bi-lock"></i>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword"></label>
                                <div class="auth-input-group">
                                    <i class="bi bi-lock-fill"></i>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber"></label>
                            <div class="auth-input-group">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="PhoneNumber" type="text" class="form-control" placeholder="(123) 456-7890" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StreetAddress"></label>
                            <div class="auth-input-group">
                                <i class="bi bi-geo-alt"></i>
                                <input asp-for="StreetAddress" type="text" class="form-control" placeholder="123 Main St" />
                            </div>
                            <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label asp-for="City"></label>
                                <input asp-for="City" type="text" class="form-control" placeholder="New York" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="State"></label>
                                <input asp-for="State" type="text" class="form-control" placeholder="NY" />
                                <span asp-validation-for="State" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="PostalCode"></label>
                                <input asp-for="PostalCode" type="text" class="form-control" placeholder="10001" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Role"></label>
                            <select asp-for="Role" asp-items="@Model.RoleList" class="form-select">
                                <option disabled selected value="">-- Select Role --</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100" asp-action="Register">
                            <i class="bi bi-person-check me-2"></i>Create Account
                        </button>
                    </form>

                    <div class="auth-divider">or</div>

                    <p class="text-center mb-0 text-secondary small">
                        Already have an account?
                        <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold text-decoration-none" style="color: #17A34A;">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}