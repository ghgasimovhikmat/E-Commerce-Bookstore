@model IEnumerable<Product>
<partial name="_Hero" />

<div class="container py-5" id="catalog">
    <div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <p class="catalog-eyebrow mb-1">The Full Catalog</p>
            <h2 class="catalog-heading mb-1">Our Collection</h2>
            <p class="text-secondary mb-0">Explore all @Model.Count() books across every category</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm book-card">
                        <div class="book-card-img-wrap">
                            <span class="book-badge-overlay">@product.Category.Name</span>
                            <a asp-action="Details" asp-route-productId="@product.Id" class="text-decoration-none">
                                <div style="aspect-ratio: 3/4; overflow: hidden; border-radius: 1rem 1rem 0 0;">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" class="w-100 h-100" style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #1e293b, #334155);">
                                            <i class="bi bi-book display-4" style="color: #64748b;"></i>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h6 class="fw-semibold mb-1" style="min-height: 2.5rem;">
                                <a asp-action="Details" asp-route-productId="@product.Id" class="text-decoration-none book-title-link">
                                    @product.Title
                                </a>
                            </h6>
                            <p class="text-secondary small mb-3">by @product.Author</p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="book-price">@product.Price100.ToString("c")</span>
                                    @if (product.ListPrice > product.Price100)
                                    {
                                        <div class="book-price-old">@product.ListPrice.ToString("c")</div>
                                    }
                                </div>
                                <a asp-action="Details" asp-route-productId="@product.Id" class="book-view-btn">
                                    View <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox d-block"></i>
            <p class="mb-0">No books available right now. Check back soon.</p>
        </div>
    }
</div>
<partial name="_Newsletter" />